# Copy this file to `.env` for local development.
#
# Use `.env`, NOT `.env.local`. Next.js reads both, but the Prisma CLI only
# reads `.env` — so putting the database URLs in `.env.local` gives you a
# working website and a `prisma` command that can't find the database.
#
# NEVER commit a file containing real secrets — .env* (except .env.example)
# is gitignored on purpose. See docs/ARCHITECTURE.md section H.1.

# --- Database -----------------------------------------------------------
# Local dev (provisioned by scripts/dev-db-setup.sh) — no pooler locally,
# so both variables point at the same local database:
DATABASE_URL="postgresql://hatgao:hatgao_dev_local@localhost:5432/hatgao_dev"
DIRECT_URL="postgresql://hatgao:hatgao_dev_local@localhost:5432/hatgao_dev"

# Using Neon instead of a local database? REPLACE the two values above —
# do not paste connection strings into these comment lines, they are
# inactive. Neon's Connect panel gives you two different strings:
#   * the POOLED one (hostname contains "-pooler") goes in DATABASE_URL
#   * the DIRECT one (no "-pooler")               goes in DIRECT_URL
# The app uses the pooled one; only the Prisma CLI uses the direct one.

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth.js ----------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Stripe (test mode keys from the Stripe dashboard) -----------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Wolt Drive API ------------------------------------------------------
# Values from Wolt's technical onboarding — see the contract analysis doc
# for the exact list of what's still needed.
WOLT_API_BASE_URL="https://daas-public-api.development.dev.woltapi.com"
WOLT_MERCHANT_ID=""
WOLT_VENUE_ID=""
WOLT_API_TOKEN=""
WOLT_WEBHOOK_CLIENT_SECRET=""

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="orders@hatgaocy.com"

# --- Product photo uploads (Vercel Blob) -----------------------------------
# Vercel dashboard → Storage → Create Database → Blob → create a store →
# copy the "BLOB_READ_WRITE_TOKEN" it gives you. On a Vercel deployment this
# is usually injected automatically once the store is linked to the
# project; for local dev, paste it here.
BLOB_READ_WRITE_TOKEN=""

# --- Geocoding (address lookup at checkout) -------------------------------
# Provider TBD — see architecture doc Section K.3 item 21.
GEOCODING_API_KEY=""

# --- Internal job runner ---------------------------------------------------
# Long random string; guards the /api/internal/jobs/tick endpoint so only
# our own scheduler can trigger it.
INTERNAL_JOB_SECRET=""

# --- Error monitoring -------------------------------------------------
SENTRY_DSN=""
