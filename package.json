{
  "name": "hatgao-ordering",
  "version": "0.1.0",
  "private": true,
  "description": "HAT GAO direct ordering system — customer site, admin dashboard, and API in one Next.js app.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/verify/002_seed_menu.sql",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test:domain": "tsx tests/unit/domain.test.ts",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "db:constraints": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/verify/004_constraints.sql",
    "staff:create": "tsx scripts/create-staff-user.ts",
    "staff:reset-password": "tsx scripts/reset-staff-password.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^8.0.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.0.0",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.41.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "sharp": "^0.35.3",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
